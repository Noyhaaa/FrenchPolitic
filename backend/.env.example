# Copier en .env et adapter. Aucune valeur réelle ici : JWT_SECRET est nommé
# ci-dessous mais sa valeur se choisit dans votre .env, jamais dans ce fichier.

# --- API ---
APP_ENV=dev
API_CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# --- Comptes utilisateurs ---
# Signe les jetons de session. En dev, laisser vide : un secret éphémère est
# tiré à chaque démarrage (il faut alors se reconnecter après un redémarrage).
# Hors dev, l'application REFUSE de démarrer sans lui.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# JWT_TTL_HEURES=720                  # 30 jours (défaut)

# --- Base de données (Phase 1) ---
# REPOSITORY_BACKEND=postgres        # "memory" (défaut, seed) ou "postgres"
# DATABASE_URL=postgresql+asyncpg://localhost:5432/frenchpolitics

# --- Génération IA ---
# LLM_PROVIDER=mock                     # "mock" = AUCUN LLM (défaut) | ollama
# LLM_MODEL=mistral-small:24b           # modèle servi par Ollama
# LLM_BASE_URL=http://localhost:11434   # serveur Ollama (local ou distant)
# Usage actuel du LLM à l'ingestion : classification de thème + réponses aux
# questions citoyennes ancrées sur l'exposé des motifs (app/ai/questions.py,
# validées par contrôles déterministes — rejet au moindre doute). PAS de résumé
# neutre généré par LLM : le gabarit déterministe reste seul maître (README §IA).
